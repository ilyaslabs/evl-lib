{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilyaslabs.github.io/evl-lib/schema/1.0/evl-view.schema.json",
  "title": "Shared EVL view (.evl/views/*.evl-view.yaml)",
  "description": "Generated from the evl-core spec tables. Do not edit by hand; run ./gradlew generateSpec.",
  "type": "object",
  "required": [
    "name",
    "location"
  ],
  "properties": {
    "evl": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "type": "string",
          "description": "Element reference the view opens on."
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Expanded path of element ids."
        },
        "perspective": {
          "type": "string",
          "enum": [
            "FLOW",
            "ARCHITECTURE",
            "DATA",
            "EVENTS"
          ]
        }
      },
      "additionalProperties": false
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "positions": {
      "type": "object",
      "description": "Element key → {x, y} layout hints.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
