{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilyaslabs.github.io/evl-lib/schema/1.0/evl-manifest.schema.json",
  "title": "EVL manifest (evl.yaml)",
  "description": "Generated from the evl-core spec tables. Do not edit by hand; run ./gradlew generateSpec.",
  "type": "object",
  "required": [
    "evl",
    "id",
    "name"
  ],
  "properties": {
    "evl": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "APPLICATION",
        "LIBRARY"
      ]
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "see": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "inferred": {
          "type": "boolean"
        }
      }
    },
    "rules": {
      "type": "object",
      "description": "Rule code → level (error, warning, weak_warning, info, off).",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "error",
          "warning",
          "weak_warning",
          "info",
          "off"
        ]
      }
    },
    "artifact": {
      "type": [
        "string",
        "object"
      ]
    },
    "domain": {
      "type": "string"
    },
    "doc": {
      "type": "string"
    },
    "concurrency": {
      "type": "string"
    },
    "performance": {
      "type": "string"
    },
    "security": {
      "type": "string"
    },
    "failure": {
      "type": "string"
    },
    "source": {
      "type": [
        "string",
        "object"
      ]
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false
}
